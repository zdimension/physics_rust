
print([
    "precedence",
    "+ L", "+ R",
    "- L", "- R",
    "* L", "* R",
    "/ L", "/ R",
    "% L", "% R",
    "^ L", "^ R",
    ".. L", ".. R"
]);

print([
    10,
    10 + 2 $$$%$$% 3,    10 $$$%$$% 2 + 3,
    20 - 2 $$$%$$% 3,    20 $$$%$$% 2 - 3,
    2 * 3 $$$%$$% 4,     2 $$$%$$% 3 * 4,
    16 / 4 $$$%$$% 2,    16 $$$%$$% 4 / 2,
    20 % 6 $$$%$$% 5,    20 $$$%$$% 6 % 5,
    2 ^ 3 $$$%$$% 2,     2 $$$%$$% 3 ^ 2,
    1 .. 3 $$$%$$% 9,    1 $$$%$$% 3 .. 5
]);

print([
    11,
    10 + 2 $$$%$%$ 3,    10 $$$%$%$ 2 + 3,
    20 - 2 $$$%$%$ 3,    20 $$$%$%$ 2 - 3,
    2 * 3 $$$%$%$ 4,     2 $$$%$%$ 3 * 4,
    16 / 4 $$$%$%$ 2,    16 $$$%$%$ 4 / 2,
    20 % 6 $$$%$%$ 5,    20 $$$%$%$ 6 % 5,
    2 ^ 3 $$$%$%$ 2,     2 $$$%$%$ 3 ^ 2,
    1 .. 3 $$$%$%$ 9,    1 $$$%$%$ 3 .. 5
]);
