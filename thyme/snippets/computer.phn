Scene.addCircle {
    zDepth = 403.0;
    opaqueBorders = true;
    textureMatrix = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    drawCake = false;
    body = 821;
    vel = [0.0, 0.0];
    collideWater = false;
    angvel = 0.0;
    pos = [0.91780108, 4.7720833];
    geomID = 560;
    radius = 0.43000001;
    entityID = 853;
    controllerAcc = 0;
    color = [0.215, 0.215, 0.215, 1.0];
    drawBorder = false;
    onCollide = (e)=>{
        e.this.controllerInvertX ? {
            e.this.collideSet == 16 ? {
                e.this.textureMatrix = [0, e.other.textureMatrix(1), 0, 0, 0, 0, 0, 0, 0];
                e.this.collideSet = 8;
                e.other.collideSet = 1;
                e.this.color = [1, 1, 1, 1]
            } : {
                e.other.textureMatrix = [0, e.this.textureMatrix(1), 0, 0, 0, 0, 0, 0, 0];
                e.other.controllerInvertY = true;
                e.other.collideSet = 1;
                e.this.collideSet = 16;
                e.other.text = e.this.text + " [done]";
                e.this.controllerInvertX = false;
                e.this.color = [0, 0, 0, 1]
            }
        } : {
            e.this.collideSet == 16 ? {
                e.this.collideSet = 1;
                e.this.textureMatrix = [e.other.textureMatrix(0), e.other.textureMatrix(1), 0, 0, 0, 0, 0, 0, 0];
                e.this.text = e.other.text;
                e.other.text = "";
                e.other.collideSet = 8;
                e.this.color = [1, 1, 1, e.other.color(3)]
            } : {
                e.this.collideSet = 16;
                e.other.collideSet = 64;
                e.other.text = e.this.text;
                e.this.text == "to a" ? {
                    e.other.controllerInvertX = true;
                    e.other.textureMatrix = e.this.textureMatrix;
                    e.other.controllerAcc = 16;
                    e.other.collideSet = 4
                } : {};
                e.this.text == "to b" ? {
                    e.other.controllerInvertX = true;
                    e.other.textureMatrix = e.this.textureMatrix;
                    e.other.controllerAcc = 32;
                    e.other.collideSet = 4
                } : {};
                e.this.text == "to c" ? {
                    e.other.controllerInvertX = true;
                    e.other.textureMatrix = e.this.textureMatrix;
                    e.other.controllerAcc = 64;
                    e.other.collideSet = 4
                } : {};
                e.this.text == "from a" ? {
                    e.this.controllerInvertX = true;
                    e.other.controllerInvertX = false;
                    e.other.textureMatrix = e.this.textureMatrix;
                    e.other.controllerAcc = 16;
                    e.other.collideSet = 4
                } : {};
                e.this.text == "from b" ? {
                    e.this.controllerInvertX = true;
                    e.other.controllerInvertX = false;
                    e.other.textureMatrix = e.this.textureMatrix;
                    e.other.controllerAcc = 32;
                    e.other.collideSet = 4
                } : {};
                e.this.text == "from c" ? {
                    e.this.controllerInvertX = true;
                    e.other.controllerInvertX = false;
                    e.other.textureMatrix = e.this.textureMatrix;
                    e.other.controllerAcc = 64;
                    e.other.collideSet = 4
                } : {};
                e.this.text == "system boost on" ? {
                    e.other.text = e.this.text + "[done] DON'T FORGET TO TURN OFF THE SYSTEM BOOST!";
                    sim.timeDelta = 0.0049999999;
                    e.other.color = [0.62, 0, 0, 1]
                } : {};
                e.this.text == "system boost off" ? {
                    e.other.text = e.this.text + "[done] The system runs on normal speed now.";
                    sim.timeDelta = 0.0099999998;
                    e.other.color = [0.34, 0.34, 0.34, 1]
                } : {};
                e.this.text == "exit" ? {
                    sim.timeDelta = 0.0099999998;
                    sim.running = false
                } : {};
                e.this.color = [0, 0, 0, e.other.color(3)]
            }
        }
    };
    heteroCollide = true;
    angle = -0.77910894;
    collideSet = 16
};
